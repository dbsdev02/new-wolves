SECRET_KEY=your-super-secret-production-key-change-this-immediately
DEBUG=False
ALLOWED_HOSTS=backend.wolvesint.org,www.backend.wolvesint.org

# Leave commented to use SQLite, or set MySQL URL from cPanel
# DATABASE_URL=mysql://db_user:db_pass@localhost/db_name

CORS_ALLOWED_ORIGINS=https://new.wolvesint.ae,https://www.new.wolvesint.ae

FRONTEND_URL=https://new.wolvesint.ae

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@wolvesint.org
ADMIN_EMAIL=admin@wolvesint.org

# Redis not available on shared cPanel hosting
# REDIS_URL=

USE_S3=False
USE_CLOUDINARY=False
